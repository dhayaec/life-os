# Database (Neon Postgres — dev branch)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/lifeos?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional — email/password + magic link work without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Vercel Blob (Documents module) — provision via: vercel blob create-store --access private --yes
BLOB_READ_WRITE_TOKEN=""
