# Database (Neon Postgres — dev branch)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/lifeos?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional — email/password + magic link work without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Vercel Blob (Documents module) — provision via: vercel blob create-store --access private --yes
BLOB_READ_WRITE_TOKEN=""

# AI assistant (Vercel AI Gateway) — optional. AI features (briefing, summarize,
# tasks-from-note, natural-language search) show a "not configured" state until
# a key is set. Get one at: vercel.com/d/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=""
AI_MODEL="anthropic/claude-sonnet-4.6"

# Resend (transactional email) — get a key at resend.com/api-keys.
# EMAIL_FROM defaults to Resend's test sender, which only delivers to your own
# account inbox; swap in a verified domain (e.g. "LifeOS <noreply@yoursite.com>") later.
RESEND_API_KEY=""
EMAIL_FROM="LifeOS <onboarding@resend.dev>"