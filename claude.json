    ],
    "devOps": [
      "Docker image built and tested",
      "Kubernetes manifests validated",
      "CI/CD pipeline passing",
      "Automated deployments working",
      "Database backups automated",
      "Monitoring dashboards created",
      "Alert rules configured",
      "Log retention policies set",
      "Secret rotation configured",
      "Network security reviewed"
    ]
  },

  "developmentWorkflow": {
    "branchNaming": {
      "format": "{type}/{description}",
      "types": [
        "feature/",
        "fix/",
        "refactor/",
        "docs/",
        "test/",
        "perf/",
        "security/"
      ],
      "examples": [
        "feature/oauth-google-login",
        "fix/cart-price-calculation",
        "refactor/auth-service",
        "perf/image-lazy-loading",
        "security/sql-injection-fix"
      ]
    },
    "pullRequestTemplate": {
      "title": "Clear, descriptive title",
      "description": "What problem does this PR solve?",
      "motivation": "Why are these changes needed?",
      "testing": "How were these changes tested?",
      "checklist": [
        "Self-review completed",
        "Comments added for complex logic",
        "Documentation updated",
        "Tests added",
        "No breaking changes (or documented)",
        "TypeScript errors resolved",
        "Linting passes",
        "Performance impact considered",
        "Accessibility impact considered",
        "Security impact considered"
      ]
    }
  },

  "tools": {
    "required": [
      {
        "name": "husky",
        "version": ">=8.0.0",
        "purpose": "Git hooks",
        "setupCmd": "npx husky install"
      },
      {
        "name": "lint-staged",
        "version": ">=13.0.0",
        "purpose": "Run linters on staged files",
        "config": ".lintstagedrc.js"
      },
      {
        "name": "commitlint",
        "version": ">=17.0.0",
        "purpose": "Enforce commit message standards",
        "config": ".commitlintrc.js"
      },
      {
        "name": "eslint",
        "version": ">=8.0.0",
        "plugins": [
          "@typescript-eslint/eslint-plugin",
          "eslint-plugin-react",
          "eslint-plugin-react-hooks",
          "eslint-plugin-next",
          "eslint-plugin-jsx-a11y",
          "eslint-plugin-import"
        ],
        "config": ".eslintrc.js"
      },
      {
        "name": "prettier",
        "version": ">=3.0.0",
        "purpose": "Code formatting",
        "config": ".prettierrc"
      },
      {
        "name": "typescript",
        "version": ">=5.0.0",
        "config": "tsconfig.json (strict mode)"
      }
    ],
    "optional": [
      {
        "name": "vitest",
        "purpose": "Unit testing",
        "recommended": true
      },
      {
        "name": "playwright",
        "purpose": "E2E testing",
        "recommended": true
      },
      {
        "name": "axe-core",
        "purpose": "Accessibility testing",
        "recommended": true
      },
      {
        "name": "bundlesize",
        "purpose": "Bundle size monitoring",
        "recommended": true
      },
      {
        "name": "npm-audit",
        "purpose": "Security vulnerability scanning",
        "builtin": true
      },
      {
        "name": "@next/bundle-analyzer",
        "purpose": "Analyze bundle composition",
        "recommended": true
      }
    ]
  }
}
